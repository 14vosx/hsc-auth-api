{
  "name": "hsc-auth-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "start:player-analytics-worker": "node player-analytics-worker.js",
    "db:migrate": "node scripts/migrate.js",
    "build:nest": "tsc -p tsconfig.nest.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "tsc -p tsconfig.vitest.json",
    "smoke:local": "npm run build:nest && node scripts/smoke-local.js",
    "smoke:deploy": "node scripts/smoke-deploy.js",
    "preflight:deploy": "node scripts/preflight-deploy.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "amqplib": "2.0.1",
    "dotenv": "^17.3.1",
    "mysql2": "^3.18.0",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tar": "7.5.19"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@swc/core": "1.15.47",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "1.5.9",
    "vitest": "4.1.10"
  }
