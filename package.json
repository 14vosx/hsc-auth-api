{
  "name": "hsc-auth-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "db:migrate": "node scripts/migrate.js",
    "test": "npm run test:legacy && npm run test:nest",
    "build:nest": "tsc -p tsconfig.nest.json",
    "test:legacy": "node --test $(find test -type f -name '*.test.js' -print | sort)",
    "test:nest": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test $(find dist-test/test/nest -type f -name '*.test.js' -print | sort)"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "dotenv": "^17.3.1",
    "mysql2": "^3.18.0",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.9.3"
  }
}
