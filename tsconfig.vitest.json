{
  "extends": "./tsconfig.nest.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "test/vitest/**/*.ts",
    "test/vitest/**/*.js",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-test"
  ]
}
