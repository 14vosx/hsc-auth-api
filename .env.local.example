# HSC Auth API — Local environment template
# Copie para: .env.local

# Opcional: indicar caminho do arquivo de ambiente (padrão: .env)
# ENV_FILE=.env.local

NODE_ENV=development
PORT=3000
AUTH_API_PUBLIC_URL=http://127.0.0.1:3000

# MariaDB local via Docker (compose)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=hsc_auth
DB_USER=hsc
DB_PASS=hsc

# Frontend local (ajuste se necessário)
ALLOWED_ORIGIN=http://localhost:5173

# Admin (somente local; em prod vem do /opt/hsc/hsc-auth-api/.env)
ADMIN_KEY=dev-admin-key

# Internal APIs and Steam profile cache
INTERNAL_API_KEY=
SERVER_ACCESS_INTERNAL_API_KEY=
STEAM_API_KEY=
STEAM_PROFILE_CACHE_TTL_SECONDS=86400
STEAM_API_TIMEOUT_SECONDS=8

# Player Bunker local artifacts and optional Static API v2 profile enrichment
PLAYER_BUNKER_ARTIFACT_ROOT=
PLAYER_BUNKER_ACTIVE_SEASON_SLUG=
PLAYER_BUNKER_STATIC_API_BASE_URL=http://127.0.0.1:8080/api/cs2/v2
PLAYER_BUNKER_STATIC_API_TIMEOUT_MS=1500

# Uploads locais controlados pela Auth API
UPLOAD_DIR=./var/uploads
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_PUBLIC_BASE_URL=http://127.0.0.1:3000
UPLOAD_MAX_BYTES=2097152

# Shared SMTP transport
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Player email authentication
PLAYER_EMAIL_AUTH_ENABLED=false
PLAYER_EMAIL_VERIFICATION_TTL_MINUTES=30
PLAYER_EMAIL_VERIFICATION_URL=/portal/cs2-next/verify-email
PLAYER_EMAIL_FROM=no-reply@haxixesmokeclub.com
PLAYER_EMAIL_VERIFICATION_SUBJECT=Verify your HSC account
PLAYER_EMAIL_PASSWORD_RESET_TTL_MINUTES=30
PLAYER_EMAIL_PASSWORD_RESET_URL=/portal/cs2-next/reset-password
PLAYER_EMAIL_PASSWORD_RESET_SUBJECT=Reset your HSC password
PLAYER_STEAM_LINK_TTL_MINUTES=10
PLAYER_STEAM_LINK_RETURN_URL=https://auth-api.haxixesmokeclub.com/player/auth/steam/link/callback
PLAYER_STEAM_LINK_REDIRECT_URL=https://haxixesmokeclub.com/area-do-jogador
PLAYER_EMAIL_LINK_TTL_MINUTES=30
PLAYER_EMAIL_LINK_URL=/portal/cs2-next/link-email
PLAYER_EMAIL_LINK_SUBJECT=Link your email to HSC
